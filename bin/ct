#!/usr/bin/env node
// ct — ClaudeTools CLI. Dependency-free so `npx` works with nothing installed.
import { spawnSync } from 'node:child_process';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';

const HERE = dirname(fileURLToPath(import.meta.url));
const TOOLS = join(HERE, '..', 'tools');

const COMMANDS = {
  init:    ['init.mjs',    'Write a claudetools.config.json for a target repo (interactive; --yes for flags-only)'],
  render:  ['render.mjs',  'Render templates into a target repo, then generate budgets + file-patterns'],
  check:   ['check.mjs',   'Verify a rendered repo (or --templates for this repo\'s own hygiene)'],
  diff:    ['diff.mjs',    'Show what render would change, without writing'],
  extract: ['extract.mjs', 'Refresh templates from an upstream checkout (read-only on upstream)'],
};

const [cmd, ...rest] = process.argv.slice(2);

if (!cmd || cmd === '--help' || cmd === '-h' || cmd === 'help') {
  console.log('ct — portable Claude Code toolchain\n');
  console.log('usage: ct <command> [options]\n');
  for (const [name, [, desc]] of Object.entries(COMMANDS)) {
    console.log(`  ${name.padEnd(8)} ${desc}`);
  }
  console.log('\ncommon flags:');
  console.log('  --target <dir>   repo to operate on (default: cwd)');
  console.log('  --dry-run        render without writing');
  console.log('  --force          overwrite locally-modified files (run `ct diff` first)');
  console.log('\ntypical first run:');
  console.log('  ct init   --target ../my-repo');
  console.log('  ct render --target ../my-repo');
  console.log('  ct check  --target ../my-repo');
  process.exit(cmd ? 0 : 1);
}

if (!COMMANDS[cmd]) {
  console.error(`unknown command: ${cmd}`);
  console.error(`try one of: ${Object.keys(COMMANDS).join(', ')}`);
  process.exit(2);
}

const res = spawnSync(process.execPath, [join(TOOLS, COMMANDS[cmd][0]), ...rest], { stdio: 'inherit' });
process.exit(res.status ?? 1);
