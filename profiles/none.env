# No tracker. Issues are markdown files under .ai/issues/; the lock is a
# directory. Useful to trial the pipeline before wiring a real tracker.

VOCAB_ISSUE="issue"
VOCAB_ISSUES="issues"
VOCAB_ISSUE_CAP="Issue"
VOCAB_PR="PR"
VOCAB_PRS="PRs"
VOCAB_BOARD="backlog"
VOCAB_REVIEWER="the reviewer"

TRACKER_ISSUE_REF_FORMAT='#${ID}'
TRACKER_ISSUE_URL=''
TRACKER_VIEW_ISSUE='cat .ai/issues/${ID}.md'
TRACKER_LIST_ISSUES='ls .ai/issues/'
TRACKER_CREATE_ISSUE='mkdir -p .ai/issues && $EDITOR .ai/issues/${ID}.md'
TRACKER_COMMENT_ISSUE='printf "\n\n---\n%s\n" ${BODY} >> .ai/issues/${ID}.md'
TRACKER_CLOSE_ISSUE='mkdir -p .ai/issues/closed && git mv .ai/issues/${ID}.md .ai/issues/closed/'
TRACKER_ADD_LABEL='printf "label: %s\n" ${LABEL} >> .ai/issues/${ID}.labels'
TRACKER_REMOVE_LABEL='sed -i "/^label: ${LABEL}$/d" .ai/issues/${ID}.labels'
# No board. Anything the rules say about moving status does not apply — the
# rendered prose says so via TRACKER_BOARD_NAME below.
TRACKER_SET_STATUS='(no board — skip this step)'
TRACKER_BOARD_NAME="the local .ai/issues/ directory (no board — status-tracking steps do not apply)"
TRACKER_BOARD_URL=''
TRACKER_CLOSE_KEYWORD='Closes #${ID}'
TRACKER_REF_KEYWORD='Refs #${ID}'

# `mkdir` is the one POSIX primitive that atomically fails-if-exists. A lockfile
# via `touch` has a check-then-act window two agents can both pass through — do
# not substitute one. Single machine only: mkdir atomicity is not reliable
# across hosts on a shared network filesystem.
TRACKER_LOCK_MECHANISM='a lock DIRECTORY under .ai/issues/.locks/ — `mkdir` fails if it exists, which is the atomic compare-and-set POSIX gives for free (a `touch` lockfile is NOT atomic and must not be substituted)'
TRACKER_LOCK_ACQUIRE='mkdir .ai/issues/.locks/${ID}'
TRACKER_LOCK_RELEASE='rmdir .ai/issues/.locks/${ID}'
TRACKER_LOCK_QUERY='ls -d .ai/issues/.locks/${ID} 2>/dev/null'

VCS_DEFAULT_BASE="$PROJECT_MAIN_BRANCH"
VCS_CREATE_PR=''
VCS_CREATE_DRAFT_PR=''
VCS_VIEW_PR=''
VCS_PR_CHECKS=''
VCS_MARK_READY=''
VCS_RERUN_FAILED_CHECKS=''
VCS_PR_URL_FORMAT=''
VCS_LIST_REVIEW_THREADS=''
VCS_RESOLVE_THREAD=''
