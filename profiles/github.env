# GitHub Issues + GitHub PRs. Source this, or pass it to setup.sh.
# ${ID}/${LABEL}/${BODY}/${TITLE}/${STATUS}/${PR}/${THREAD} stay literal — the
# agent fills them in at call time.

VOCAB_ISSUE="issue"
VOCAB_ISSUES="issues"
VOCAB_ISSUE_CAP="Issue"
VOCAB_PR="PR"
VOCAB_PRS="PRs"
VOCAB_BOARD="project board"
VOCAB_REVIEWER="Copilot"

TRACKER_ISSUE_REF_FORMAT='#${ID}'
TRACKER_ISSUE_URL='https://github.com/'"$VCS_REPO_SLUG"'/issues/${ID}'
TRACKER_VIEW_ISSUE='gh issue view ${ID} --repo '"$VCS_REPO_SLUG"' --json number,title,body,state,labels'
TRACKER_LIST_ISSUES='gh issue list --repo '"$VCS_REPO_SLUG"' --state open --limit 100'
TRACKER_CREATE_ISSUE='gh issue create --repo '"$VCS_REPO_SLUG"' --title ${TITLE} --body ${BODY}'
TRACKER_COMMENT_ISSUE='gh issue comment ${ID} --repo '"$VCS_REPO_SLUG"' --body ${BODY}'
TRACKER_CLOSE_ISSUE='gh issue close ${ID} --repo '"$VCS_REPO_SLUG"
TRACKER_ADD_LABEL='gh issue edit ${ID} --repo '"$VCS_REPO_SLUG"' --add-label ${LABEL}'
TRACKER_REMOVE_LABEL='gh issue edit ${ID} --repo '"$VCS_REPO_SLUG"' --remove-label ${LABEL}'
TRACKER_SET_STATUS='gh project item-edit --id ${ID} --field-id ${STATUS}'
TRACKER_BOARD_NAME="the GitHub project board"
TRACKER_BOARD_URL=""
TRACKER_CLOSE_KEYWORD='Closes #${ID}'
TRACKER_REF_KEYWORD='Refs #${ID}'

# The mutex. GitHub label adds are ATOMIC server-side, which is what makes
# parallel agents safe here — two agents cannot both observe an unlabelled
# issue and both come away holding the lock.
TRACKER_LOCK_MECHANISM='an `agent:*` label on the issue — label adds are atomic server-side, so adding one IS the mutex acquire'
TRACKER_LOCK_ACQUIRE='gh issue edit ${ID} --repo '"$VCS_REPO_SLUG"' --add-label ${LABEL}'
TRACKER_LOCK_RELEASE='gh issue edit ${ID} --repo '"$VCS_REPO_SLUG"' --remove-label ${LABEL}'
TRACKER_LOCK_QUERY='gh issue view ${ID} --repo '"$VCS_REPO_SLUG"" --json labels --jq '.labels[].name'"

VCS_DEFAULT_BASE="$PROJECT_MAIN_BRANCH"
VCS_CREATE_PR='gh pr create --repo '"$VCS_REPO_SLUG"' --base ${BASE} --title ${TITLE} --body ${BODY}'
VCS_CREATE_DRAFT_PR='gh pr create --draft --repo '"$VCS_REPO_SLUG"' --base ${BASE} --title ${TITLE} --body ${BODY}'
VCS_VIEW_PR='gh pr view ${PR} --repo '"$VCS_REPO_SLUG"
VCS_PR_CHECKS='gh pr checks ${PR} --repo '"$VCS_REPO_SLUG"
VCS_MARK_READY='gh pr ready ${PR} --repo '"$VCS_REPO_SLUG"
VCS_RERUN_FAILED_CHECKS='gh run rerun ${RUN} --failed'
VCS_PR_URL_FORMAT='https://github.com/'"$VCS_REPO_SLUG"'/pull/${PR}'
VCS_LIST_REVIEW_THREADS='gh api graphql -f query="query { repository(owner: \"'"${VCS_REPO_SLUG%%/*}"'\", name: \"'"${VCS_REPO_SLUG##*/}"'\") { pullRequest(number: ${PR}) { reviewThreads(first: 100) { nodes { id isResolved comments(first: 1) { nodes { path body } } } } } } }"'
VCS_RESOLVE_THREAD='gh api graphql -f query="mutation { resolveReviewThread(input: {threadId: \"${THREAD}\"}) { thread { isResolved } } }"'
