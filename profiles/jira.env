# JIRA tickets. Written against the `jira` CLI (ankitpokhrel/jira-cli); swap the
# command strings for curl+REST if your org standardises on that — nothing else
# changes. ${ID} is a full key (PROJ-123), not a bare number.
#
# ⚠ READ THE LOCK NOTE BELOW BEFORE RUNNING PARALLEL AGENTS.

VOCAB_ISSUE="ticket"
VOCAB_ISSUES="tickets"
VOCAB_ISSUE_CAP="Ticket"
VOCAB_PR="MR"
VOCAB_PRS="MRs"
VOCAB_BOARD="JIRA board"
VOCAB_REVIEWER="the reviewer"

TRACKER_ISSUE_REF_FORMAT='${ID}'
TRACKER_ISSUE_URL="$JIRA_BASE_URL"'/browse/${ID}'
TRACKER_VIEW_ISSUE='jira issue view ${ID} --plain'
TRACKER_LIST_ISSUES="jira issue list --plain --no-headers -q 'statusCategory != Done ORDER BY updated DESC'"
TRACKER_CREATE_ISSUE='jira issue create --type Task --summary ${TITLE} --body ${BODY} --no-input'
TRACKER_COMMENT_ISSUE='jira issue comment add ${ID} ${BODY}'
TRACKER_CLOSE_ISSUE='jira issue move ${ID} Done'
TRACKER_ADD_LABEL='jira issue edit ${ID} --label ${LABEL} --no-input'
TRACKER_REMOVE_LABEL='jira issue edit ${ID} --label -${LABEL} --no-input'
TRACKER_SET_STATUS='jira issue move ${ID} ${STATUS}'
TRACKER_BOARD_NAME="the JIRA board"
TRACKER_BOARD_URL="$JIRA_BASE_URL"
TRACKER_CLOSE_KEYWORD='Closes ${ID}'
TRACKER_REF_KEYWORD='Refs ${ID}'

# ⚠ THE LOCK IS NOT ATOMIC THE WAY GITHUB'S IS.
#
# GitHub's mutex works because a label add is atomic server-side. JIRA's label
# edit is a read-modify-write on an array: two agents can both read an
# unlabelled ticket, both write their label, and BOTH believe they hold the
# lock. There is no error — just two agents on the same ticket racing on one
# branch.
#
# The assignee field is the compare-and-set surface instead (single-valued, so
# the second write overwrites rather than merges). The acquire below MUST be
# followed by a read-back: assign, then re-read the assignee, and abort if it
# is not you. For a serial fleet this doesn't matter; for a parallel one it is
# the whole ballgame.
TRACKER_LOCK_MECHANISM='a JIRA label plus assignment to the agent account. JIRA has no atomic label-add, so the assignee field is the compare-and-set surface — after acquiring, RE-READ the assignee and abort if it is not you'
TRACKER_LOCK_ACQUIRE='jira issue assign ${ID} '"$JIRA_AGENT_ACCOUNT"' && jira issue view ${ID} --plain | grep -i "^assignee" # verify you won'
TRACKER_LOCK_RELEASE='jira issue edit ${ID} --label -${LABEL} --no-input && jira issue assign ${ID} x'
TRACKER_LOCK_QUERY='jira issue view ${ID} --plain | grep -iE "^(labels|assignee)"'

VCS_DEFAULT_BASE="$PROJECT_MAIN_BRANCH"
VCS_CREATE_PR='glab mr create --target-branch ${BASE} --title ${TITLE} --description ${BODY}'
VCS_CREATE_DRAFT_PR='glab mr create --draft --target-branch ${BASE} --title ${TITLE} --description ${BODY}'
VCS_VIEW_PR='glab mr view ${PR}'
VCS_PR_CHECKS='glab ci status'
VCS_MARK_READY='glab mr update ${PR} --ready'
VCS_RERUN_FAILED_CHECKS='glab ci retry'
VCS_PR_URL_FORMAT='https://gitlab.com/'"$VCS_REPO_SLUG"'/-/merge_requests/${PR}'
VCS_LIST_REVIEW_THREADS='glab api projects/:id/merge_requests/${PR}/discussions'
# GitLab has no "resolve thread" equivalent to GitHub's mutation — reply to
# each discussion and resolve in the UI. Left blank deliberately.
VCS_RESOLVE_THREAD=''

# Set these before sourcing, or edit after setup:
#   JIRA_BASE_URL       e.g. https://acme.atlassian.net
#   JIRA_AGENT_ACCOUNT  account id the fleet assigns while holding the lock
